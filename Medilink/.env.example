# ============================================================================
# MediLink — environment variables (copy to .env / per-workspace .env.local).
# Keys mirror the reused HAMS backend. NEVER commit real values.
# Legend:  PUBLIC = safe for browser/mobile (NEXT_PUBLIC_/EXPO_PUBLIC_);
#          SECRET = backend-only — must never reach frontend or mobile bundles.
#
# This file is kept in sync with what the code actually reads. Every key below is read
# by backend/, frontend/, shared/ or supabase/functions/; nothing here is aspirational.
# Mobile-only EXPO_PUBLIC_* keys are mirrored here for convenience but their canonical
# home is mobile/.env.example.
#
# REQUIRED vs OPTIONAL is enforced in code, not by this file:
#   • backend/src/lib/env.ts   — validated at server boot (secrets are read per request)
#   • frontend/src/lib/env.ts  — validated at module load, so `next build` fails
#                                (NEXT_PUBLIC_* are inlined into the bundle at build time)
#   • mobile/src/config/envGuard.js — build-time production guard
# Only the three Supabase values below are truly required; everything else is
# feature-scoped and its absence disables exactly one capability. Each of those code
# modules documents what breaks without a given variable.
#
# NOT settable here, on purpose:
#   NODE_ENV     — set by Next.js per command (dev/build/start). Overriding it by hand
#                  is a reliable way to get a production bundle in development.
#   SUPABASE_URL — read only by supabase/functions/*; the Edge runtime injects it
#                  automatically. Do not set it for the Next apps, which use
#                  NEXT_PUBLIC_SUPABASE_URL.
# ============================================================================

# ---- Supabase (existing HAMS project — reused) ----
# These three are the only REQUIRED variables in the whole backend contract.
NEXT_PUBLIC_SUPABASE_URL=              # PUBLIC  (required)
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # PUBLIC  (required)
SUPABASE_SERVICE_ROLE_KEY=             # SECRET  (required — backend only)
# Mobile mirrors of the public values:
EXPO_PUBLIC_SUPABASE_URL=              # PUBLIC
EXPO_PUBLIC_SUPABASE_ANON_KEY=         # PUBLIC

# ---- App / service URLs ----
# NEXT_PUBLIC_APP_URL is NOT interpolation-safe: payments/checkout builds
# "undefined/payment-success" if it is unset, so treat it as required for any deploy that
# takes payments (the Google OAuth callback does fall back to http://localhost:3000).
NEXT_PUBLIC_APP_URL=                   # PUBLIC (frontend origin)
NEXT_PUBLIC_BACKEND_URL=               # PUBLIC (web → backend API origin; empty = same-origin,
                                       #         so a split deployment MUST set it)
EXPO_PUBLIC_BACKEND_URL=               # PUBLIC (mobile → backend API origin; legacy fallback
                                       #         for EXPO_PUBLIC_API_URL)
# Added to the backend's CORS allow-list in backend/src/middleware.ts. Either name works;
# both are read, and an unset value is simply dropped from the list.
NEXT_PUBLIC_FRONTEND_URL=              # PUBLIC (web origin allowed to call the backend)
FRONTEND_URL=                          # PUBLIC (server-side alias for the same entry)

# ---- Phone verification — Twilio Verify (BACKEND ONLY) ----
# Read ONLY by POST /api/auth/phone/{start,check}, which link a verified phone number to an
# existing account. Phone LOGIN does not use these: it runs client-side through Supabase
# Auth, whose own Twilio credentials live in the SUPABASE DASHBOARD, not here.
#
# NEVER prefix any of these EXPO_PUBLIC_ / NEXT_PUBLIC_. TWILIO_AUTH_TOKEN carries full
# account authority; it belongs in the server environment only and must never reach a
# client bundle, a log line, an API response or git.
#
# Unset = phone linking is disabled and returns 503. Nothing else is affected.
TWILIO_ACCOUNT_SID=                    # PUBLIC-ish identifier (AC…), still server-side
TWILIO_AUTH_TOKEN=                     # SECRET — full account authority, never commit
TWILIO_VERIFY_SERVICE_SID=             # identifier (VA…) of the Verify service

# ---- Payments — Thawani (the only payment provider) ----
# These six are the complete set the code reads; there are no others.
THAWANI_BASE_URL=                      # SECRET
THAWANI_SECRET_KEY=                    # SECRET
THAWANI_PUBLISHABLE_KEY=               # PUBLIC
# Hosted-checkout host. UAT: https://uatcheckout.thawani.om — PROD: https://checkout.thawani.om
# (defaults to UAT if unset). MUST be set to the production host for real-money deploys.
THAWANI_CHECKOUT_BASE_URL=             # PUBLIC
# Webhook HMAC (BP-6, defense-in-depth). If set, the payments webhook verifies
# HMAC-SHA256(rawBody) against the signature header. Leave unset to skip (the Thawani
# re-query remains the authoritative anti-spoof guard).
THAWANI_WEBHOOK_SECRET=                # SECRET
THAWANI_WEBHOOK_SIGNATURE_HEADER=      # PUBLIC (header name; default "thawani-signature")

# NOTE: there is no Stripe integration. The STRIPE_* keys that used to sit here were
# never read by any code and the `stripe` dependency has been removed — do not source
# Stripe credentials for this project.

# ---- Google CALENDAR sync (backend only) ----
# NOT login. These belong to the Calendar OAuth client (scope=.../auth/calendar) used by
# backend/src/app/api/auth/google/* to store tokens in `user_integrations`. Google
# SIGN-IN is a completely separate integration that uses different clients and does not
# read any of these — see the note below. Do not point both at one client.
GOOGLE_CLIENT_ID=                      # SECRET
GOOGLE_CLIENT_SECRET=                  # SECRET
GOOGLE_REDIRECT_URI=                   # SECRET

# ---- Google SIGN-IN (login) ----
# There are NO backend/frontend env vars for Google login, by design:
#   • Web    — supabase.auth.signInWithOAuth(). The Web client ID + SECRET are entered in
#              the Supabase dashboard (Authentication → Providers → Google), never here.
#              A NEXT_PUBLIC_* copy would be pointless and the secret must stay off the
#              browser bundle entirely.
#   • Mobile — native ID-token flow; the public client IDs live in mobile/.env.example
#              as EXPO_PUBLIC_GOOGLE_*.
# Full setup: docs/GOOGLE_SIGN_IN_SETUP.md

# ---- Google Geocoding (clinic address → coordinates; server-only) ----
# Set as a Supabase Edge Function secret for `geocode-facility`
# (`supabase secrets set GOOGLE_GEOCODING_API_KEY=...`). NEVER exposed to the client.
# Distinct from the Android app.json Google Maps key.
GOOGLE_GEOCODING_API_KEY=              # SECRET

# ---- AI (Me Assistant / Insights) ----
# Provider is Groq (llama-3.3-70b-versatile) — the only AI provider actually wired up.
# GROQ_API_KEY is REQUIRED in every environment: AI features have NO mock/stub fallback,
# so a missing key returns a graceful 5xx error, never fake data. (The former MOCK_AI
# stub flag has been removed — production always calls the real provider.)
GROQ_API_KEY=                          # SECRET (all four AI routes 5xx without it)
GROQ_MODEL=                            # PUBLIC (optional model override; defaults to
                                       #         llama-3.3-70b-versatile. Exists so a
                                       #         decommissioned Groq snapshot is an env
                                       #         change, not a code change.)
# NOTE: Groq is the only AI provider. GEMINI_API_KEY used to be listed here; no code ever
# read it and the @google/generative-ai dependency has been removed — do not source a
# Gemini key for this project.

# ---- Email — TRANSACTIONAL ONLY (Nodemailer → Microsoft 365 / Outlook) ----
# Scope. These drive APPLICATION email only: appointment booking confirmation,
# cancellation, reschedule, payment receipt / invoice, staff invitations, notification
# mirrors. AUTHENTICATION email — signup verification, email confirmation, password
# reset, login OTP — is sent by SUPABASE AUTH's own mailer (configured in the Supabase
# dashboard) and reads NONE of these variables. Do not wire auth mail through Nodemailer:
# it would duplicate delivery and bypass Supabase's token templating and rate limits.
#
# Provider is Microsoft 365, NOT Gmail. `service: "gmail"` has been removed from every
# module; the single transporter lives in backend/src/lib/email/transporter.ts.
#
# AUTH IS OAUTH2, NOT A PASSWORD. Microsoft refuses Basic SMTP auth whenever Entra
# security defaults are enabled:
#   535 5.7.139 … user is locked by your organization's security defaults policy
# Security defaults stay ON. The backend authenticates with an Entra app-only token over
# XOAUTH2 instead, so no user password is involved and the policy does not apply.
#
# These three are SERVER-ONLY secrets. There is deliberately NO NEXT_PUBLIC_/EXPO_PUBLIC_
# variant of any of them — a client copy of the client secret would be a full compromise
# of the mailbox.
# Tenant ID and client ID are IDENTIFIERS, not credentials — they appear in every OAuth
# request and in the decoded token, exactly like a Google OAuth client ID. They are still
# server-only here because nothing client-side needs them. The client SECRET is the credential.
MICROSOFT_TENANT_ID=                   # SERVER-ONLY (Entra directory/tenant ID; not a credential)
MICROSOFT_CLIENT_ID=                   # SERVER-ONLY (Entra app registration client ID; not a credential)
MICROSOFT_CLIENT_SECRET=               # SECRET (Entra client secret — never commit, never log)
#
# Microsoft side, required once per tenant (see docs/EMAIL_ARCHITECTURE.md):
#   • Office 365 Exchange Online → SMTP.SendAsApp APPLICATION permission + admin consent
#     (Microsoft Graph "Mail.Send" is NOT sufficient — it does not enable SMTP submission)
#   • Exchange service principal registered for the app, granted rights on the mailbox
#   • SMTP AUTH enabled on the mailbox itself
#
# Defaults if unset: smtp.office365.com : 587 with STARTTLS. SMTP_SECURE must stay false
# on 587 — implicit TLS on that port hangs until timeout instead of failing cleanly. Only
# set it "true" together with SMTP_PORT=465.
SMTP_HOST=                             # PUBLIC (default smtp.office365.com)
SMTP_PORT=                             # PUBLIC (default 587)
SMTP_SECURE=                           # PUBLIC ("true" only with port 465)
# The mailbox to submit as. Required in BOTH auth modes — XOAUTH2 carries it alongside the
# token, and the token must be authorised for exactly this mailbox.
SMTP_USER=                             # SECRET (the mailbox, e.g. alerts@medilink.om)
# LEGACY Basic-auth password. Kept only as a rollback path and IGNORED whenever the
# MICROSOFT_* variables above are set. A partial OAuth config is reported as an error
# rather than silently downgrading to this — that downgrade is what reintroduces the 535.
# Remove it once OAuth2 is confirmed working.
SMTP_PASS=                             # SECRET (deprecated — prefer OAuth2)
EMAIL_FROM=                            # PUBLIC (From address; falls back to SMTP_USER)
# Extra trusted root, for a dev machine behind a TLS-intercepting proxy or endpoint
# antivirus (Norton "Web/Mail Shield", ESET, Kaspersky, Zscaler, corporate MITM). Those
# products re-sign outbound TLS with a private root they install into the OS store; Node
# does NOT read the OS store, so it rejects the chain with
#   "self-signed certificate in certificate chain"
# and email silently stops working. Point this at the interception root as PEM.
#
# It ADDS a root — certificate verification stays fully ON. rejectUnauthorized is never
# disabled anywhere in this codebase, and the bundled roots are always kept (passing `ca`
# REPLACES Node's trust store, so supplying only the proxy root would break normal chains).
#
# LEAVE UNSET in staging/production — there is no interception there.
# NB: NODE_EXTRA_CA_CERTS cannot be used from a .env file — Node reads it at process start,
# before Next loads dotenv. That is why this exists as an app-level variable.
SMTP_CA_FILE=                          # PUBLIC (path to a PEM; local dev only)
# Deprecated aliases, still read as a fallback so an un-migrated environment keeps
# sending. Prefer SMTP_USER / SMTP_PASS in anything new.
EMAIL_USER=                            # SECRET (deprecated → SMTP_USER)
EMAIL_PASS=                            # SECRET (deprecated → SMTP_PASS)

# ---- Misc ----
INVITE_SECRET=                         # SECRET

# ---- Internal API docs (Scalar / OpenAPI) ----
# Enables GET /api/docs and GET /api/openapi.json. Off by default.
# In production these stay 404 unless the caller is an authenticated internal admin.
ENABLE_API_DOCS=false                  # backend flag — set "true" in dev/staging

# ─────────────────────────────────────────────────────────────────────────────
# Sentry — error reporting (OPTIONAL; all three surfaces are inert when unset)
# ─────────────────────────────────────────────────────────────────────────────
# Leave blank and nothing is initialised: no network calls, no overhead, no
# behaviour change. Paste a DSN to switch reporting on.
#
# SECRET? No. A DSN is a public, write-only ingest key and is designed to ship in
# client bundles — same category as the Supabase anon key.
#
# SENTRY_DSN             — server runtimes (backend API + frontend SSR)
# NEXT_PUBLIC_SENTRY_DSN — the browser bundle (frontend only)
# EXPO_PUBLIC_SENTRY_DSN — the mobile app (set per EAS profile; see mobile/.env.example)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Source-map upload is NOT wired yet. It needs SENTRY_AUTH_TOKEN (a real secret) plus
# `withSentryConfig` in next.config.ts, which changes production bundling — deliberately
# left as an explicit follow-up. Without it events still arrive; browser/mobile stack
# traces are just minified.
# SENTRY_AUTH_TOKEN=
