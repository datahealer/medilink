# ============================================================================
# MediLink — environment variables (copy to .env / per-workspace .env.local).
# Keys mirror the reused HAMS backend. NEVER commit real values.
# Legend:  PUBLIC = safe for browser/mobile (NEXT_PUBLIC_/EXPO_PUBLIC_);
#          SECRET = backend-only — must never reach frontend or mobile bundles.
# ============================================================================

# ---- Supabase (existing HAMS project — reused) ----
NEXT_PUBLIC_SUPABASE_URL=              # PUBLIC
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # PUBLIC
SUPABASE_SERVICE_ROLE_KEY=             # SECRET (backend only)
# Mobile mirrors of the public values:
EXPO_PUBLIC_SUPABASE_URL=              # PUBLIC
EXPO_PUBLIC_SUPABASE_ANON_KEY=         # PUBLIC

# ---- App / service URLs ----
NEXT_PUBLIC_APP_URL=                   # PUBLIC (frontend origin)
NEXT_PUBLIC_BACKEND_URL=               # PUBLIC (web → backend API origin)
EXPO_PUBLIC_BACKEND_URL=               # PUBLIC (mobile → backend API origin)

# ---- Payments — Thawani (the only payment provider) ----
# These six are the complete set the code reads; there are no others.
THAWANI_BASE_URL=                      # SECRET
THAWANI_SECRET_KEY=                    # SECRET
THAWANI_PUBLISHABLE_KEY=               # PUBLIC
# Hosted-checkout host. UAT: https://uatcheckout.thawani.om — PROD: https://checkout.thawani.om
# (defaults to UAT if unset). MUST be set to the production host for real-money deploys.
THAWANI_CHECKOUT_BASE_URL=             # PUBLIC
# Webhook HMAC (BP-6, defense-in-depth). If set, the payments webhook verifies
# HMAC-SHA256(rawBody) against the signature header. Leave unset to skip (the Thawani
# re-query remains the authoritative anti-spoof guard).
THAWANI_WEBHOOK_SECRET=                # SECRET
THAWANI_WEBHOOK_SIGNATURE_HEADER=      # PUBLIC (header name; default "thawani-signature")

# NOTE: there is no Stripe integration. The STRIPE_* keys that used to sit here were
# never read by any code and the `stripe` dependency has been removed — do not source
# Stripe credentials for this project.

# ---- Google (OAuth + Calendar) ----
GOOGLE_CLIENT_ID=                      # SECRET
GOOGLE_CLIENT_SECRET=                  # SECRET
GOOGLE_REDIRECT_URI=                   # SECRET

# ---- Google Geocoding (clinic address → coordinates; server-only) ----
# Set as a Supabase Edge Function secret for `geocode-facility`
# (`supabase secrets set GOOGLE_GEOCODING_API_KEY=...`). NEVER exposed to the client.
# Distinct from the Android app.json Google Maps key.
GOOGLE_GEOCODING_API_KEY=              # SECRET

# ---- AI (Me Assistant / Insights) ----
# Provider is Groq (llama-3.3-70b-versatile) — the only AI provider actually wired up.
# GROQ_API_KEY is REQUIRED in every environment: AI features have NO mock/stub fallback,
# so a missing key returns a graceful 5xx error, never fake data. (The former MOCK_AI
# stub flag has been removed — production always calls the real provider.)
GROQ_API_KEY=                          # SECRET (required)
# NOTE: Groq is the only AI provider. GEMINI_API_KEY used to be listed here; no code ever
# read it and the @google/generative-ai dependency has been removed — do not source a
# Gemini key for this project.

# ---- Email (Resend / nodemailer) ----
EMAIL_USER=                            # SECRET
EMAIL_PASS=                            # SECRET
EMAIL_FROM=                            # SECRET

# ---- Misc ----
INVITE_SECRET=                         # SECRET

# ---- Internal API docs (Scalar / OpenAPI) ----
# Enables GET /api/docs and GET /api/openapi.json. Off by default.
# In production these stay 404 unless the caller is an authenticated internal admin.
ENABLE_API_DOCS=false                  # backend flag — set "true" in dev/staging

# ─────────────────────────────────────────────────────────────────────────────
# Sentry — error reporting (OPTIONAL; all three surfaces are inert when unset)
# ─────────────────────────────────────────────────────────────────────────────
# Leave blank and nothing is initialised: no network calls, no overhead, no
# behaviour change. Paste a DSN to switch reporting on.
#
# SECRET? No. A DSN is a public, write-only ingest key and is designed to ship in
# client bundles — same category as the Supabase anon key.
#
# SENTRY_DSN             — server runtimes (backend API + frontend SSR)
# NEXT_PUBLIC_SENTRY_DSN — the browser bundle (frontend only)
# EXPO_PUBLIC_SENTRY_DSN — the mobile app (set per EAS profile; see mobile/.env.example)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Source-map upload is NOT wired yet. It needs SENTRY_AUTH_TOKEN (a real secret) plus
# `withSentryConfig` in next.config.ts, which changes production bundling — deliberately
# left as an explicit follow-up. Without it events still arrive; browser/mobile stack
# traces are just minified.
# SENTRY_AUTH_TOKEN=
