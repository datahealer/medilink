{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "module": "ESNext",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@medilink/shared": [
        "../shared/src/index.ts"
      ],
      "@medilink/shared/*": [
        "../shared/src/*"
      ]
    },
    "allowJs": true,
    "incremental": true,
    // Tests run on Node's built-in runner, which executes TypeScript by stripping types and
    // does NO extension guessing — so test files import `../module.ts` explicitly. This flag
    // permits that syntax. Safe here because `noEmit` is already true: it changes what tsc
    // accepts, never what it emits, and application code keeps extensionless imports so the
    // Next build is untouched.
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
