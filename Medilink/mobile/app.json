{
  "expo": {
    "name": "MediLink",
    "slug": "medilink",
    "scheme": "medilink",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inzint.medilink",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.medilink.app",
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2E1A47"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/me-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2E1A47"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/me-mark.png",
          "color": "#2E1A47"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MediLink uses your photos to set a profile picture.",
          "cameraPermission": "MediLink uses your camera to capture medical documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MediLink uses your location to find nearby clinics.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0aed5a20-7493-41b9-8f0f-8fcdbcc3b458"
      },
      "router": {}
    },
    "owner": "ayush-inzint"
  }
}
