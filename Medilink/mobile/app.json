{
  "expo": {
    "name": "MediLink",
    "slug": "medilink",
    "scheme": "medilink",
    "version": "0.1.0",
    "icon": "./assets/images/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inzint.medilink",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Used to securely unlock your saved session.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.medilink.app",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2E1A47"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MediLink uses your photos to set a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0aed5a20-7493-41b9-8f0f-8fcdbcc3b458"
      },
      "router": {}
    },
    "owner": "ayush-inzint"
  }
}
