# App environment
EXPO_PUBLIC_APP_ENV=development

# Data source: mock | staging | production
#   mock        → typed in-memory data, NO backend calls (UI-first; the dev default)
#   staging     → real HAMS/Supabase against staging
#   production  → real HAMS/Supabase against production
# In mock mode the SUPABASE/API vars below are optional (safe fallbacks are used).
EXPO_PUBLIC_DATA_MODE=mock

# Backend API (HAMS Next.js) — used for privileged ops such as Thawani payment checkout.
# The value MUST be a host the device/emulator can actually reach:
#   • Physical phone : your laptop's LAN IP, e.g. http://192.168.1.20:3000 (NOT localhost),
#                      with the phone on the SAME Wi-Fi and the laptop firewall allowing TCP 3000.
#   • Android emulator: http://10.0.2.2:3000  (10.0.2.2 = the host machine; "localhost" is auto-
#                      rewritten to this on Android by the app's apiFetch helper).
#   • iOS simulator  : http://localhost:3000   (the simulator shares the host network).
#   • Staging/prod   : the deployed HTTPS URL, e.g. https://staging.medilink.om
# IMPORTANT: start HAMS bound to all interfaces so the device can connect:  next dev -H 0.0.0.0
#
# ANDROID + PLAIN HTTP: `usesCleartextTraffic` was removed from app.json (PHI must not
# travel unencrypted in a release build). Android release builds therefore block http://
# entirely. If a plain-http LAN URL stops working on Android, use the HTTPS tunnel instead
# of re-adding the flag — @expo/ngrok is already a devDependency:
#     npx expo start --tunnel
# and set EXPO_PUBLIC_API_URL to the https:// tunnel origin.
EXPO_PUBLIC_API_URL=http://YOUR_LAPTOP_IP:3000
# Legacy fallback for the line above — src/config/env.ts reads API_URL first and falls back
# to this, so older .env files keep working after the rename. Prefer EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_BACKEND_URL=

# Supabase public client config — add later if mobile connects directly to Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth public client IDs — add later when OAuth is configured
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# NOTE: there is no EXPO_PUBLIC_EXPO_PROJECT_ID. This key used to be listed here and was
# read by nothing. The EAS project ID lives in app.json (`expo.extra.eas.projectId`) and
# src/services/push.ts reads it from `Constants.expoConfig.extra.eas.projectId` — so push
# registration already has it and needs no env var.

# Sentry ingest URL — optional. Leave blank and error reporting stays completely inert
# (the SDK is never loaded). Paste the DSN from the Sentry project to switch it on.
# Native crash capture + readable stack traces additionally need the
# @sentry/react-native/expo config plugin and a rebuild — see src/services/reporting.
EXPO_PUBLIC_SENTRY_DSN=
